        <sensitiveness>2.0</sensitiveness>
        <kp>1</kp>
        <kd>0.05</kd>
      </reconfigurableJoint>
    </plugin>
    <plugin filename="libgazebo_odometry_plugin.so" name="flygripper_odometry_plugin">
      <robotNamespace>flygripper</robotNamespace>
      <linkName>odom_link</linkName>
      <randomEngineSeed>0</randomEngineSeed>
      <noiseNormalPosition>0.0 0.0 0.0</noiseNormalPosition>
      <noiseNormalQuaternion>0.0 0.0 0.0</noiseNormalQuaternion>
      <noiseNormalLinearVelocity>0.0 0.0 0.0</noiseNormalLinearVelocity>
      <noiseNormalAngularVelocity>0.0 0.0 0.0</noiseNormalAngularVelocity>
      <rosOdomTopicName>odom</rosOdomTopicName>
      <frameId>world</frameId>
      <childFrameId>flygripper</childFrameId>
      <!-- xjb 没啥用 不发 tf-->
      <publishFrequency>333</publishFrequency>
      <measurementDelay>0.0</measurementDelay>
    </plugin>
    <plugin filename="libgazebo_imu_plugin.so" name="flygripper_imu_plugin">
      <robotNamespace>flygripper</robotNamespace>
      <linkName>imu_link</linkName>
      <frameId>flygripper</frameId>
      <!-- xjb 没啥用 不发 tf -->
      <randomEngineSeed>0</randomEngineSeed>
      <gyroscopeNoiseDensity>0.0</gyroscopeNoiseDensity>
      <!-- 0.0003394 -->
      <gyroscopeBiasRandomWalk>0.0</gyroscopeBiasRandomWalk>
      <!-- 0.000038785 -->
      <gyroscopeBiasCorrelationTime>0.0</gyroscopeBiasCorrelationTime>
      <!-- 1000.0 -->
      <gyroscopeTurnOnBiasSigma>0.0</gyroscopeTurnOnBiasSigma>
      <!-- 0.0087 -->
      <accelerometerNoiseDensity>0.0</accelerometerNoiseDensity>
      <!-- 0.004 -->
      <accelerometerRandomWalk>0.0</accelerometerRandomWalk>
      <!-- 0.006 -->
      <accelerometerBiasCorrelationTime>0</accelerometerBiasCorrelationTime>
      <!-- 300.0 -->
      <accelerometerTurnOnBiasSigma>0.0</accelerometerTurnOnBiasSigma>
      <!-- 0.1960 -->
      <rosImuTopicName>imu</rosImuTopicName>
      <publishFrequency>333</publishFrequency>
    </plugin>
    <plugin filename="libgazebo_grasp_plugin.so" name="flygripper_grasp_plugin">
      <robotNamespace>flygripper</robotNamespace>
      <updateRate>100</updateRate>
      <disableCollisionsOnAttach>true</disableCollisionsOnAttach>
      <graspForcesAngleTolerance>120</graspForcesAngleTolerance>
      <graspCountThreshold>2</graspCountThreshold>
      <graspCountMax>4</graspCountMax>
      <releaseDistanceTolerance>0.01</releaseDistanceTolerance>
      <releaseToleranceMode>+</releaseToleranceMode>
      <gripperLink>left_up_link</gripperLink>
      <gripperLink>odom</gripperLink>
      <gripperLink>right_down_link</gripperLink>
      <gripperLink>right_up_link</gripperLink>
      <rosGraspTopicName>grasp_status</rosGraspTopicName>
    </plugin>
  </gazebo>
  <gazebo reference="right_up_link">
    <mu1 value="10.0"/>
    <mu2 value="50.0"/>
    <kp value="1000000.0"/>
    <kd value="1.0"/>
  </gazebo>
  <gazebo reference="right_down_link">
    <mu1 value="10.0"/>
    <mu2 value="50.0"/>
    <kp value="1000000.0"/>
    <kd value="1.0"/>
  </gazebo>
  <gazebo reference="left_up_link">
    <mu1 value="10.0"/>
    <mu2 value="50.0"/>
    <kp value="1000000.0"/>
    <kd value="1.0"/>
  </gazebo>
  <gazebo reference="left_down_link">
    <mu1 value="10.0"/>
    <mu2 value="50.0"/>
    <kp value="1000000.0"/>
    <kd value="1.0"/>
  </gazebo>
  <!-- Spring and damper configuration for morphing -->
  <gazebo reference="left_prismatic_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <gazebo reference="down_prismatic_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <gazebo reference="right_prismatic_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <gazebo reference="left_revolute_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <gazebo reference="right_revolute_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
  </gazebo>
</robot>

