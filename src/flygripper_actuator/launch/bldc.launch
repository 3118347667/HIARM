<launch>
    <!-- common parameters -->
    <arg name="mav_name"  default="flygripper"/>
    <arg name="namespace" default="$(arg mav_name)"/>

    <arg name="actuator_bus" default="uart_can"/> <!--socket_can, uart_can -->
    <arg name="actuator_interface" default="/dev/CAN_MOTOR"/> <!--can0, /dev/CAN_MOTOR -->

    <!-- need sudo privilege -->
    <group ns="$(arg namespace)">
        <node pkg="flygripper_actuator" type="bldc_node" name="bldc_node" output="screen">
            <rosparam command="load" file="$(find flygripper_actuator)/params/bldc_control.yaml"/>
            <rosparam command="load" file="$(find flygripper_actuator)/params/bldc.yaml"/>
            <param name="actuator_bus" value="$(arg actuator_bus)"/>
            <param name="actuator_interface" value="$(arg actuator_interface)"/>
        </node>
    </group>
</launch>