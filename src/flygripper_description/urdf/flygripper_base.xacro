<!-- GAZEBO PLUGIN -->
<xacro:if value="${use_sim}">
    <gazebo>
        <plugin name="${namespace}_rotor_plugin" filename="libgazebo_rotor_plugin.so">
            <robotNamespace>${namespace}</robotNamespace>
            <rotor id="0">
                <jointName>right_up_rotor_joint</jointName>
                <linkName>right_up_rotor_link</linkName>
                <turningDirection>ccw</turningDirection>
            </rotor>
            <rotor id="1">
                <jointName>left_down_rotor_joint</jointName>
                <linkName>left_down_rotor_link</linkName>
                <turningDirection>ccw</turningDirection>
            </rotor>
            <rotor id="2">
                <jointName>left_up_rotor_joint</jointName>
                <linkName>left_up_rotor_link</linkName>
                <turningDirection>cw</turningDirection>
            </rotor>
            <rotor id="3">
                <jointName>right_down_rotor_joint</jointName>
                <linkName>right_down_rotor_link</linkName>
                <turningDirection>cw</turningDirection>
            </rotor>
            <motorConstant>7.19543e-9</motorConstant> <!-- 4.76e-9 -->
            <momentConstant>1.12968e-10</momentConstant>  <!-- 7.536e-11 -->
            <rotorDragCoefficient>0.0</rotorDragCoefficient>
            <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
            <maxRotVelocity>18167.64672310778</maxRotVelocity> <!-- 3002 -->
            <timeConstantUp>0.0</timeConstantUp> <!-- 0.0125 -->
            <timeConstantDown>0.0</timeConstantDown> <!-- 0.025 -->
            <dshotRpmMappingCoefficient>0.0094 -8.746306995940205e-06 1.791322293868279e-09</dshotRpmMappingCoefficient>
            <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
            <rosCommandTopicName>rotor_command</rosCommandTopicName>
            <rosFeedbackTopicName>rotor_speed</rosFeedbackTopicName>
        </plugin>

        <plugin name="${namespace}_reconfigurable_plugin" filename="libgazebo_reconfigurable_plugin.so">
            <commandRateLimit>1.0</commandRateLimit>
            <robotNamespace>${namespace}</robotNamespace>
            <rosCommandTopicName>actuator_command</rosCommandTopicName>
            <rosFeedbackTopicName>actuator_state</rosFeedbackTopicName>
            <reconfigurableJoint id="0">
                <jointName>right_prismatic_joint</jointName>
                <multiplier>-0.01</multiplier> <!-- Mapping control input from 0-1.0 -->
                <offset>0.0</offset>
                <sensitiveness>0.0</sensitiveness>
                <kp>20</kp>
                <kd>5</kd>
            </reconfigurableJoint>
            <reconfigurableJoint id="1">
                <jointName>down_prismatic_joint</jointName>
                <multiplier>-0.01</multiplier>
                <offset>0.0</offset>
                <sensitiveness>0.0</sensitiveness>
                <kp>20</kp>
                <kd>5</kd>
            </reconfigurableJoint>
            <reconfigurableJoint id="2">
                <jointName>left_prismatic_joint</jointName>
                <multiplier>-0.01</multiplier>
                <offset>0.0</offset>
                <sensitiveness>0.0</sensitiveness>
                <kp>20</kp>
                <kd>5</kd>
            </reconfigurableJoint>
            <reconfigurableJoint id="3">
                <jointName>left_revolute_joint</jointName>
                <multiplier>0.2616</multiplier>
                <offset>0.0</offset>
                <sensitiveness>2.0</sensitiveness>
                <kp>4.0</kp>
                <kd>1.0</kd>
            </reconfigurableJoint>
            <reconfigurableJoint id="4">
                <jointName>right_revolute_joint</jointName>
                <multiplier>0.2616</multiplier>
                <offset>0.0</offset>
                <sensitiveness>2.0</sensitiveness>
                <kp>4.0</kp>
                <kd>1.0</kd>
            </reconfigurableJoint>
        </plugin>

        <plugin name="${namespace}_odometry_plugin" filename="libgazebo_odometry_plugin.so">
            <robotNamespace>${namespace}</robotNamespace>
            <linkName>odom_link</linkName>
            <randomEngineSeed>0</randomEngineSeed>
            <noiseNormalPosition>0.0 0.0 0.0</noiseNormalPosition>
            <noiseNormalQuaternion>0.0 0.0 0.0</noiseNormalQuaternion>
            <noiseNormalLinearVelocity>0.0 0.0 0.0</noiseNormalLinearVelocity>
            <noiseNormalAngularVelocity>0.0 0.0 0.0</noiseNormalAngularVelocity>
            <rosOdomTopicName>odom</rosOdomTopicName>
            <frameId>world</frameId>
            <childFrameId>${namespace}</childFrameId> <!-- xjb 没啥用 不发 tf-->
            <publishFrequency>333</publishFrequency>
            <measurementDelay>0.0</measurementDelay>
        </plugin>

        <plugin name="${namespace}_imu_plugin" filename="libgazebo_imu_plugin.so">
            <robotNamespace>${namespace}</robotNamespace>
            <linkName>imu_link</linkName>
            <frameId>${namespace}</frameId> <!-- xjb 没啥用 不发 tf -->
            <randomEngineSeed>0</randomEngineSeed>
            <gyroscopeNoiseDensity>0.0</gyroscopeNoiseDensity> <!-- 0.0003394 -->
            <gyroscopeBiasRandomWalk>0.0</gyroscopeBiasRandomWalk> <!-- 0.000038785 -->
            <gyroscopeBiasCorrelationTime>0.0</gyroscopeBiasCorrelationTime> <!-- 1000.0 -->
            <gyroscopeTurnOnBiasSigma>0.0</gyroscopeTurnOnBiasSigma> <!-- 0.0087 -->
            <accelerometerNoiseDensity>0.0</accelerometerNoiseDensity> <!-- 0.004 -->
            <accelerometerRandomWalk>0.0</accelerometerRandomWalk> <!-- 0.006 -->
            <accelerometerBiasCorrelationTime>0</accelerometerBiasCorrelationTime> <!-- 300.0 -->
            <accelerometerTurnOnBiasSigma>0.0</accelerometerTurnOnBiasSigma> <!-- 0.1960 -->
            <rosImuTopicName>imu</rosImuTopicName>
            <publishFrequency>333</publishFrequency>
        </plugin>

        <plugin name="${namespace}_grasp_plugin" filename="libgazebo_grasp_plugin.so">
            <robotNamespace>${namespace}</robotNamespace>
            <updateRate>100</updateRate>
            <disableCollisionsOnAttach>true</disableCollisionsOnAttach>
            <commandedRelease>true</commandedRelease>
            <releaseStartPosition>4.5</releaseStartPosition>
            <fullyOpenPosition>0.5</fullyOpenPosition>
            <graspForcesAngleTolerance>120</graspForcesAngleTolerance>
            <graspCountThreshold>2</graspCountThreshold>
            <graspCountMax>4</graspCountMax>
            <releaseDistanceTolerance>0.01</releaseDistanceTolerance>
            <releaseToleranceMode>+</releaseToleranceMode>
            <gripperLink>left_up_link</gripperLink>
            <gripperLink>odom</gripperLink>
            <gripperLink>right_down_link</gripperLink>
            <gripperLink>right_up_link</gripperLink>
            <rosGraspTopicName>grasp_status</rosGraspTopicName>
        </plugin>

        <plugin name="${namespace}_interactive_plugin" filename="libgazebo_interactive_plugin.so">
            <robotNamespace>${namespace}</robotNamespace>
            <linkName>right_down_link</linkName>
            <relativeForce>false</relativeForce>
            <relativeTorque>true</relativeTorque>
            <rosCommandTopicName>applied_wrench</rosCommandTopicName>
            <commandTimeout>1.0</commandTimeout>
        </plugin>

    </gazebo>

        <!-- High friction configuration for grasping -->
        <xacro:gazebo_link_high_friction link="right_up_link"/>
        <xacro:gazebo_link_high_friction link="right_down_link"/>
        <xacro:gazebo_link_high_friction link="left_up_link"/>
        <xacro:gazebo_link_high_friction link="left_down_link"/>

       <!-- Spring and damper configuration for morphing -->
        <gazebo reference="left_prismatic_joint">
            <implicitSpringDamper>1</implicitSpringDamper>
            <provideFeedback>true</provideFeedback>
        </gazebo>
        <gazebo reference="down_prismatic_joint">
            <implicitSpringDamper>1</implicitSpringDamper>
            <provideFeedback>true</provideFeedback>
        </gazebo>
        <gazebo reference="right_prismatic_joint">
            <implicitSpringDamper>1</implicitSpringDamper>
            <provideFeedback>true</provideFeedback>
        </gazebo>
        <gazebo reference="left_revolute_joint">
            <implicitSpringDamper>1</implicitSpringDamper>
            <provideFeedback>true</provideFeedback>
        </gazebo>
        <gazebo reference="right_revolute_joint">
            <implicitSpringDamper>1</implicitSpringDamper>
            <provideFeedback>true</provideFeedback>
        </gazebo>

</xacro:if>

</robot>
