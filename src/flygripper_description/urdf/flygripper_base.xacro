<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="flygripper">
    <xacro:arg name="namespace" default="flygripper" />
    <xacro:arg name="use_sim" default="false" />

    <!-- Include common files -->
    <xacro:include filename="common.xacro" />
    <xacro:include filename="materials.xacro" />

    <!-- CONSTANT -->
    <xacro:property name="namespace" value="$(arg namespace)" />
    <xacro:property name="use_sim" value="$(arg use_sim)" />
    <xacro:property name="mesh_path" value="package://flygripper_description/models/flygripper" />

    <!-- LINK FRICTION MACRO -->
    <xacro:macro name="gazebo_link_0_friction" params="link">
        <gazebo reference="${link}">
            <mu1 value="0.0" />
            <mu2 value="0.0" />
            <kp value="1000000.0" />
            <kd value="1.0" />
        </gazebo>
    </xacro:macro>

    <xacro:macro name="gazebo_link_high_friction" params="link">
        <gazebo reference="${link}">
            <mu1 value="10.0" />
            <mu2 value="50.0" />
            <kp value="1000000.0" />
            <kd value="1.0" />
        </gazebo>
    </xacro:macro>

    <!-- PULLEY PROPERTY -->
    <xacro:property name="motor_max_torque"    value="1.0"/>                                      <!-- N*m -->
    <xacro:property name="motor_max_velocity"  value="11.5"/>                                     <!-- rad/s -->

    <xacro:property name="pulley_radius"       value="0.02"/>                                     <!-- m -->
    <xacro:property name="pulley_max_force"    value="${motor_max_torque / pulley_radius}"/>      <!-- N -->
    <xacro:property name="pulley_max_velocity" value="${motor_max_velocity * pulley_radius}"/>    <!-- m/s -->

    <!-- JOINT LIMIT PROPERTY -->
    <xacro:property name="prismatic_joint_position_lower" value="-0.05"/> <!-- -0.05 -->
    <xacro:property name="prismatic_joint_position_upper" value="0.0"/>
    <xacro:property name="prismatic_joint_limit">
      <limit effort="${pulley_max_force}" velocity="${pulley_max_velocity}"
             lower="${prismatic_joint_position_lower}" upper="${prismatic_joint_position_upper}"/>
      <dynamics damping="2.0" friction="10.0" />
    </xacro:property>

    <xacro:property name="revolute_joint_angle_lower" value="0.0"/>
    <xacro:property name="revolute_joint_angle_upper" value="0.785"/> <!-- 0.785 -->
    <xacro:property name="revolute_joint_limit">
      <limit effort="3.0" velocity="3.14"
             lower="${revolute_joint_angle_lower}" upper="${revolute_joint_angle_upper}"/>
      <dynamics damping="1.0" friction="1.0" />
    </xacro:property>

    <!-- DEFINITION OF BASE_LINK AND VIRTUAL ROOT LINK  -->
    <xacro:property name="base_link" value="left_down_link"/>
    <link name="odom"/>
    <joint name="fixed" type="fixed">
        <parent link="odom"/>
        <child link="${base_link}"/>
    </joint>

    <!-- IMU AND ODOM -->
    <joint name="odom_joint" type="revolute">
      <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0" />
      <parent link="${base_link}"/>
      <child link="odom_link"/>
      <limit upper="0" lower="0" effort="0" velocity="0" />
    </joint>
    <link name="odom_link">
      <inertial>
          <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001" /> <!-- [kg m^2] [kg m^2] [kg m^2] [kg m^2] [kg m^2] [kg m^2] -->
          <mass value="0.01"/> <!-- kg -->
          <origin xyz="0 0 0" rpy="0 0 0" />
      </inertial>
    </link>
    <joint name="imu_joint" type="revolute">
      <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0" />
      <parent link="${base_link}"/>
      <child link="imu_link"/>
      <limit upper="0" lower="0" effort="0" velocity="0" />
    </joint>
    <link name="imu_link">
      <inertial>
          <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001" /> <!-- [kg m^2] [kg m^2] [kg m^2] [kg m^2] [kg m^2] [kg m^2] -->
          <mass value="0.015"/> <!-- kg -->
          <origin xyz="0 0 0" rpy="0 0 0" />
      </inertial>
    </link>

    <!-- ******************************************************* SOLIDWORKS TO URDF  ********************************************************************************* -->
    <link
    name="left_down_link">
    <inertial>
      <origin
        xyz="0.0013123 -0.0012234 0.018211"
        rpy="0 0 0" />
      <mass
        value="0.091794" />
      <inertia
        ixx="7.6714E-05"
        ixy="-3.4025E-05"
        ixz="-1.802E-06"
        iyy="7.0904E-05"
        iyz="-1.743E-06"
