<launch>
    <!-- common parameters -->
    <arg name="mav_name"  default="flygripper"/>
    <arg name="namespace" default="$(arg mav_name)"/>
    <arg name="use_sim"     default="true"/>

    <!-- minimum snap close_form, pub poly coefs -->
    <group ns="$(arg namespace)">
        <node pkg="flygripper_planner" name="grasp" type="grasp" output="screen">
            <rosparam command="load" file="$(find flygripper_planner)/params/command_sim.yaml" if="$(arg use_sim)"/>
            <rosparam command="load" file="$(find flygripper_planner)/params/command.yaml" unless="$(arg use_sim)"/>
            <remap from="trigger" to="/move_base_simple/goal" />
            <remap from="odom" to="/ekf/ekf_odom" unless="$(arg use_sim)"/>
        </node>
    </group>
    <node name="rviz" pkg="rviz" type="rviz"
          args="-d $(find flygripper_planner)/config/grasp.rviz" if="$(arg use_sim)"/>
</launch>
