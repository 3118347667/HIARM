<?xml version="1.0" encoding="utf-8"?>
<launch>
    <!-- common parameters -->
    <arg name="mav_name"  default="flygripper"/>
    <arg name="namespace" default="$(arg mav_name)"/>

    <group ns="$(arg namespace)">
        <node pkg="flygripper_planner" type="door" name="door" output="screen">
            <rosparam file="$(find flygripper_planner)/params/door.yaml" command="load" />
        </node>
    </group>


    <node name="rviz" pkg="rviz" type="rviz" output="screen"
          args="-d $(find flygripper_planner)/config/test.rviz">
    </node>

</launch>
