<?xml version="1.0" encoding="utf-8"?>
<launch>
    <!-- common parameters -->
   <arg name="mav_name"  default="flygripper"/>
   <arg name="namespace" default="$(arg mav_name)"/>
    <arg name="use_sim"     default="true"/>

   <group ns="$(arg namespace)">
     <node pkg="flygripper_planner" type="real" name="real" output="screen">
       <rosparam command="load" file="$(find flygripper_planner)/params/real_sim.yaml" if="$(arg use_sim)"/>
       <rosparam command="load" file="$(find flygripper_planner)/params/real.yaml" unless="$(arg use_sim)"/>
       <remap from="trigger" to="/move_base_simple/goal" />
       <remap from="odom" to="/ekf/ekf_odom" unless="$(arg use_sim)"/>
     </node>
  </group>

   <node name="rviz" pkg="rviz" type="rviz" output="screen"
     args="-d $(find flygripper_planner)/config/test.rviz" if="$(arg use_sim)"/>

</launch>
