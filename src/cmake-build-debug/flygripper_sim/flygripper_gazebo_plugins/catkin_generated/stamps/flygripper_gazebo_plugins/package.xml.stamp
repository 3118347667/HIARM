<package format="2">
    <name>flygripper_gazebo_plugins</name>
    <version>0.0.0</version>
    <description>The flygripper_gazebo_plugins package</description>

    <maintainer email="flygripper0young@gmail.com">jonne</maintainer>
    <license>TODO</license>

    <buildtool_depend>catkin</buildtool_depend>
    <depend>roscpp</depend>
    <depend>tf</depend>
    <depend>gazebo_ros</depend>
    <depend>nav_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>flygripper_msgs</depend>
    <depend>mavros_msgs</depend>
    <depend>flygripper_common</depend>

    <export>
        <gazebo_ros plugin_path="${prefix}/lib" gazebo_media_path="${prefix}" />
    </export>
</package>