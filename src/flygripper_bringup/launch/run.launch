<launch>
    <!--  real -->
    <arg name="mav_name"          default="flygripper"/>
    <arg name="use_sim"           default="true"/>
    <arg name="gui"               default="true"/>

    <include file="$(find flygripper_bringup)/launch/urdf.launch">
        <arg name="mav_name" value="$(arg mav_name)"/>
        <arg name="use_sim"  value="$(arg use_sim)"/>
        <arg name="gui"      value="$(arg gui)"/>
    </include>

    <include file="$(find flygripper_bringup)/launch/actuator.launch" unless="$(arg use_sim)">
        <arg name="mav_name" value="$(arg mav_name)"/>
    </include>

</launch>
